# The hlwgpu interface. One declaration; every side is generated from it.
#
#   scripts/gen_native_lib.py crates/hlwgpu/wgpu.api
#
# A `prim` line is the whole contract for one primitive: the name the Haxe
# side asks for, its arguments and its return. The `js` line under it is that
# primitive's body in a page, an expression with the arguments in scope plus
# `H`, the prelude's handle table. Rust bodies are not declared because they
# are `imp::<name>` by convention, and a mismatch is a link error.
#
# Types: i32, bool, bytes, void.

library wgpu
prefix hlwgpu_

# Enumerations come from the WebGPU IDL: its values, in its order, so nothing
# here is typed out and nothing can drift from the spec. The number that
# crosses is the index.
idl spec/webgpu.idl

enum GPUBlendFactor BlendFactor
enum GPUBlendOperation BlendOperation
enum GPUCompareFunction CompareFunction
enum GPUPrimitiveTopology PrimitiveTopology
enum GPUCullMode CullMode
enum GPUFrontFace FrontFace
enum GPUVertexStepMode VertexStepMode

# The kinds of object a handle can name, numbered in this order from 1. The
# number is carried in the handle so that a buffer used where a texture
# belongs is refused rather than reading a real object of the wrong type.
# Rust and JavaScript both get this list from here; neither writes it out.
kinds instance adapter device queue buffer texture view sampler shader bindgroup pipeline renderpipeline encoder surface builder

# -- instance ---------------------------------------------------------------

# The entry point. Natively this is a wgpu Instance; in a page it is
# `navigator.gpu` itself, which is why a page with WebGPU disabled returns 0
# here rather than failing later with something less obvious.
prim instance_create() -> i32
  js H.put("instance", navigator.gpu)

prim instance_destroy(inst: i32) -> void
  js H.drop("instance", inst)

# -- adapter ----------------------------------------------------------------

# Returns a request id, not an adapter. `requestAdapter` is a promise in a
# page and nothing may block on it, so async work is started here and
# collected through `request_ready` / `request_result`. Natively it resolves
# before this returns; the id exists anyway, so both look the same.
#
# `power` is 0 for low-power and 1 for high-performance.
prim adapter_request(inst: i32, power: i32) -> i32
  js H.pending(H.get("instance", inst).requestAdapter({ powerPreference: power === 1 ? "high-performance" : "low-power" }).then(a => a ? H.put("adapter", a) : 0))

prim request_ready(request: i32) -> bool
  js H.requestReady(request)

# Only meaningful once `request_ready` is true. Reading early raises rather
# than answering zero, so a caller that polls wrongly finds out here.
prim request_result(request: i32) -> i32
  js H.requestResult(request)

# UTF-16 and NUL-terminated, which is what `String.fromUCS2` expects.
prim adapter_name(adapter: i32) -> bytes
  js H.str(H.get("adapter", adapter).info.description || H.get("adapter", adapter).info.vendor || "WebGPU adapter")

# 0 unknown, 1 vulkan, 2 metal, 3 dx12, 4 gl, 5 webgpu.
prim adapter_backend(adapter: i32) -> i32
  js (H.get("adapter", adapter), 5)

# One limit by index, so that adding a limit does not add a primitive. The
# indices are declared once, in Haxe, as `wgpu.Limit`.
prim adapter_limit(adapter: i32, which: i32) -> i32
  js (H.get("adapter", adapter).limits[H.limitName(which)] | 0)

prim adapter_destroy(adapter: i32) -> void
  js H.drop("adapter", adapter)

# -- device -----------------------------------------------------------------

# The queue comes back with the device, so `device_queue` needs no request of
# its own.
prim device_request(adapter: i32) -> i32
  js H.pending(H.get("adapter", adapter).requestDevice().then(d => H.putDevice(d)))

prim device_queue(device: i32) -> i32
  js H.queueOf(device)

# Lets finished work report itself. A page does this from the event loop, so
# there is nothing to do there.
prim device_poll(device: i32) -> void
  js H.get("device", device)

prim device_destroy(device: i32) -> void
  js H.dropDevice(device)

# -- buffers ----------------------------------------------------------------

# `usage` is WebGPU's GPUBufferUsage bitmask, which wgpu numbers identically:
# 1 MAP_READ, 2 MAP_WRITE, 4 COPY_SRC, 8 COPY_DST, 128 STORAGE.
prim buffer_create(device: i32, size: i32, usage: i32) -> i32
  js H.put("buffer", H.get("device", device).createBuffer({ size, usage }))

prim queue_write_buffer(queue: i32, buffer: i32, offset: i32, data: bytes, len: i32) -> void
  js H.get("queue", queue).writeBuffer(H.get("buffer", buffer), offset, H.view(data, len))

# Starts a read mapping. Poll it with `request_ready`, then `buffer_copy_out`.
prim buffer_map_begin(device: i32, buffer: i32, offset: i32, size: i32) -> i32
  js H.pending(H.get("buffer", buffer).mapAsync(1, offset, size).then(() => 1))

# Copies from a mapped buffer into `out`. False if it was not mapped.
prim buffer_copy_out(buffer: i32, offset: i32, out: bytes, len: i32) -> bool
  js H.writeInto(out, H.get("buffer", buffer).getMappedRange(offset, len))

prim buffer_unmap(buffer: i32) -> void
  js H.get("buffer", buffer).unmap()

prim buffer_destroy(buffer: i32) -> void
  js H.drop("buffer", buffer)

# -- shaders and pipelines --------------------------------------------------

prim shader_create(device: i32, wgsl: bytes) -> i32
  js H.put("shader", H.get("device", device).createShaderModule({ code: H.readStr(wgsl) }))

prim shader_destroy(shader: i32) -> void
  js H.drop("shader", shader)

# Layout is inferred from the shader, so a bind group only needs its buffers.
prim compute_pipeline_create(device: i32, shader: i32, entry: bytes) -> i32
  js H.put("pipeline", H.get("device", device).createComputePipeline({ layout: "auto", compute: { module: H.get("shader", shader), entryPoint: H.readStr(entry) } }))

prim pipeline_destroy(pipeline: i32) -> void
  js H.drop("pipeline", pipeline)

# `bound` is `count` handles, one per binding, in binding order. Each may be a
# buffer, a texture view or a sampler: a handle carries its own kind, so what
# it binds as does not have to be said twice.
#
# The pipeline may be a compute or a render one.
prim bind_group_create(device: i32, pipeline: i32, group: i32, bound: bytes, count: i32) -> i32
  js H.put("bindgroup", H.get("device", device).createBindGroup({ layout: H.layoutOf(pipeline, group), entries: H.handles(bound, count).map((h, i) => ({ binding: i, resource: H.resource(h) })) }))

prim bind_group_destroy(bindgroup: i32) -> void
  js H.drop("bindgroup", bindgroup)

# -- commands ---------------------------------------------------------------

prim encoder_create(device: i32) -> i32
  js H.put("encoder", H.get("device", device).createCommandEncoder())

# A whole compute pass: one pipeline, one bind group, one dispatch. Passes
# with several dispatches get their own primitives when something needs them.
prim encoder_compute(encoder: i32, pipeline: i32, bindgroup: i32, x: i32, y: i32, z: i32) -> void
  js const p = H.get("encoder", encoder).beginComputePass(); p.setPipeline(H.get("pipeline", pipeline)); p.setBindGroup(0, H.get("bindgroup", bindgroup)); p.dispatchWorkgroups(x, y, z); p.end()

prim encoder_copy_buffer(encoder: i32, src: i32, src_offset: i32, dst: i32, dst_offset: i32, size: i32) -> void
  js H.get("encoder", encoder).copyBufferToBuffer(H.get("buffer", src), src_offset, H.get("buffer", dst), dst_offset, size)

# Finishes the encoder and submits it. The encoder is spent afterwards.
prim encoder_submit(encoder: i32, queue: i32) -> void
  js H.get("queue", queue).submit([H.get("encoder", encoder).finish()]); H.drop("encoder", encoder)

# Finishes when everything submitted so far has run. Takes the device because
# natively the callback fires only when one is polled, and polling is what
# `request_ready` does while waiting.
prim queue_work_done(device: i32, queue: i32) -> i32
  js H.pending(H.get("queue", queue).onSubmittedWorkDone().then(() => 1))

# -- textures ---------------------------------------------------------------

# `format` is `wgpu.TextureFormat`; `usage` is GPUTextureUsage's bits:
# 1 COPY_SRC, 2 COPY_DST, 4 TEXTURE_BINDING, 8 STORAGE_BINDING,
# 16 RENDER_ATTACHMENT.
prim texture_create(device: i32, width: i32, height: i32, format: i32, usage: i32) -> i32
  js H.put("texture", H.get("device", device).createTexture({ size: [width, height], format: H.formatName(format), usage }))

prim texture_view(texture: i32) -> i32
  js H.put("view", H.get("texture", texture).createView())

prim texture_destroy(texture: i32) -> void
  js H.drop("texture", texture)

prim view_destroy(view: i32) -> void
  js H.drop("view", view)

# -- render pipelines -------------------------------------------------------

# A render pipeline is built by a run of calls rather than one descriptor:
# every argument stays a typed scalar the compiler checks, and there is no
# packed layout for the two sides to disagree about. The crossings cost
# nothing, because a pipeline is built at load and not per frame.
prim pipeline_begin(device: i32) -> i32
  js H.put("builder", { device, vertex: { buffers: [] }, fragment: { targets: [] }, primitive: {}, depthStencil: null })

prim pipeline_shader(builder: i32, shader: i32, vs: bytes, fs: bytes) -> void
  js const d = H.get("builder", builder); d.module = H.get("shader", shader); d.vs = H.readStr(vs); d.fs = H.readStr(fs)

# Opens a vertex buffer layout; the attributes that follow belong to it.
prim pipeline_vertex_buffer(builder: i32, stride: i32, step: i32) -> void
  js H.get("builder", builder).vertex.buffers.push({ arrayStride: stride, stepMode: VERTEX_STEP_MODE[step], attributes: [] })

prim pipeline_attribute(builder: i32, format: i32, offset: i32, location: i32) -> void
  js const b = H.get("builder", builder).vertex.buffers; b[b.length - 1].attributes.push({ format: VERTEX_FORMATS[format], offset, shaderLocation: location })

# Opens a colour target; a blend that follows belongs to it.
prim pipeline_target(builder: i32, format: i32, write_mask: i32) -> void
  js H.get("builder", builder).fragment.targets.push({ format: H.formatName(format), writeMask: write_mask })

prim pipeline_blend(builder: i32, src: i32, dst: i32, op: i32, src_alpha: i32, dst_alpha: i32, op_alpha: i32) -> void
  js const t = H.get("builder", builder).fragment.targets; t[t.length - 1].blend = { color: { srcFactor: BLEND_FACTOR[src], dstFactor: BLEND_FACTOR[dst], operation: BLEND_OPERATION[op] }, alpha: { srcFactor: BLEND_FACTOR[src_alpha], dstFactor: BLEND_FACTOR[dst_alpha], operation: BLEND_OPERATION[op_alpha] } }

prim pipeline_depth(builder: i32, format: i32, write: bool, compare: i32) -> void
  js H.get("builder", builder).depthStencil = { format: H.formatName(format), depthWriteEnabled: !!write, depthCompare: COMPARE_FUNCTION[compare] }

prim pipeline_primitive(builder: i32, topology: i32, cull: i32, front: i32) -> void
  js const p = H.get("builder", builder).primitive; p.topology = PRIMITIVE_TOPOLOGY[topology]; p.cullMode = CULL_MODE[cull]; p.frontFace = FRONT_FACE[front]

# Builds the pipeline and spends the builder.
prim render_pipeline_build(builder: i32) -> i32
  js H.buildPipeline(builder)

prim render_pipeline_destroy(pipeline: i32) -> void
  js H.drop("renderpipeline", pipeline)

# -- render passes ----------------------------------------------------------

# Opens a pass that clears `view` and keeps what is drawn into it. The pass
# belongs to the encoder until `encoder_render_end`.
prim encoder_render_begin(encoder: i32, view: i32, r: f64, g: f64, b: f64, a: f64) -> void
  js H.beginPass(encoder, { colorAttachments: [{ view: H.get("view", view), clearValue: { r, g, b, a }, loadOp: "clear", storeOp: "store" }] })

prim render_set_pipeline(encoder: i32, pipeline: i32) -> void
  js H.pass(encoder).setPipeline(H.get("renderpipeline", pipeline))

prim render_set_vertex_buffer(encoder: i32, slot: i32, buffer: i32) -> void
  js H.pass(encoder).setVertexBuffer(slot, H.get("buffer", buffer))

prim render_draw(encoder: i32, vertices: i32, instances: i32) -> void
  js H.pass(encoder).draw(vertices, instances)

prim encoder_render_end(encoder: i32) -> void
  js H.endPass(encoder)

# `bytes_per_row` must be a multiple of 256, which is WebGPU's rule and not
# ours: a width of 64 RGBA pixels is exactly one row.
prim encoder_copy_texture_to_buffer(encoder: i32, texture: i32, buffer: i32, width: i32, height: i32, bytes_per_row: i32) -> void
  js H.get("encoder", encoder).copyTextureToBuffer({ texture: H.get("texture", texture) }, { buffer: H.get("buffer", buffer), bytesPerRow: bytes_per_row }, [width, height])

# -- samplers ---------------------------------------------------------------

# `filter` is 0 nearest, 1 linear. `address` is 0 clamp-to-edge, 1 repeat.
prim sampler_create(device: i32, filter: i32, address: i32) -> i32
  js H.put("sampler", H.get("device", device).createSampler({ magFilter: filter === 1 ? "linear" : "nearest", minFilter: filter === 1 ? "linear" : "nearest", addressModeU: address === 1 ? "repeat" : "clamp-to-edge", addressModeV: address === 1 ? "repeat" : "clamp-to-edge" }))

prim sampler_destroy(sampler: i32) -> void
  js H.drop("sampler", sampler)

# Unlike a copy out of a texture, this has no row alignment to honour.
prim queue_write_texture(queue: i32, texture: i32, data: bytes, width: i32, height: i32, bytes_per_row: i32) -> void
  js H.get("queue", queue).writeTexture({ texture: H.get("texture", texture) }, H.view(data, bytes_per_row * height), { bytesPerRow: bytes_per_row }, [width, height])

# -- indexed drawing --------------------------------------------------------

prim render_set_bind_group(encoder: i32, group: i32, bindgroup: i32) -> void
  js H.pass(encoder).setBindGroup(group, H.get("bindgroup", bindgroup))

# `format` is 0 for uint16 and 1 for uint32.
prim render_set_index_buffer(encoder: i32, buffer: i32, format: i32) -> void
  js H.pass(encoder).setIndexBuffer(H.get("buffer", buffer), format === 1 ? "uint32" : "uint16")

prim render_draw_indexed(encoder: i32, indices: i32, instances: i32) -> void
  js H.pass(encoder).drawIndexed(indices, instances)

# -- surfaces ---------------------------------------------------------------

# A surface on a native window, from the raw handle fields `hlwindow` reports.
# Integers because the two libraries are separate: a Rust type cannot cross
# between them, the pointer inside it can.
#
# A page has no such thing -- its surface comes from a canvas it already owns.
prim surface_create(instance: i32, platform: i32, wa: i64, wb: i64, da: i64, db: i64) -> i32
  js -

# What this surface would rather be configured as, as a `wgpu.TextureFormat`.
prim surface_preferred_format(surface: i32, adapter: i32) -> i32
  js H.canvasFormat()

prim surface_configure(device: i32, surface: i32, width: i32, height: i32, format: i32) -> void
  js H.get("surface", surface).configure({ device: H.get("device", device), format: H.formatName(format), alphaMode: "opaque" })

# The view to draw this frame into, or 0 if the surface needs configuring
# again -- which is what a resize looks like from here.
prim surface_acquire(surface: i32) -> i32
  js H.put("view", H.get("surface", surface).getCurrentTexture().createView())

# Hands the frame over, after the work drawing it has been submitted. A page
# presents at the end of its task, so this only releases the view there.
prim surface_present(queue: i32, surface: i32) -> void
  js H.releaseFrame(surface)

prim surface_destroy(surface: i32) -> void
  js H.drop("surface", surface)

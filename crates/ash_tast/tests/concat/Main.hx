class Main {
	static function label(n:Int):String {
		return "n=" + n;
	}

	static function ratio(x:Float):String {
		return "r=" + x;
	}

	static function both(a:String, b:String):String {
		return a + b;
	}

	static function join(n:Int):String {
		var s = "";
		s += n;
		s += "!";
		return s;
	}

	static function main() {}
}
